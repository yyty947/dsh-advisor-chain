{
  "name": "dsh-advisor-plugin",
  "version": "0.1.4",
  "description": "DeepSeek Harness 插件：主模型在需要时（自动判断或用户手动触发）向配置好的顾问模型链征求第二意见。顾问通过 deriveMessages() 自动继承当前会话的完整对话上下文，调用失败时按链顺延到下一个模型。",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "node -e \"const fs=require('fs');const s='lib/client.iife.js',d='lib/client.js';if(fs.existsSync(s)){fs.renameSync(s,d);console.log('renamed',s,'->',d)}else if(!fs.existsSync(d)){console.error('client bundle missing');process.exit(1)}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "advisor",
    "second-opinion",
    "fallback-chain"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
