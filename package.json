{
  "name": "dsh-advisor-chain",
  "version": "0.5.0",
  "author": "yyty947 (https://github.com/yyty947)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyty947/dsh-advisor-chain.git"
  },
  "homepage": "https://github.com/yyty947/dsh-advisor-chain#readme",
  "description": "DeepSeek Harness 插件：主模型在需要时（自动判断或用户手动触发）向配置好的顾问模型链征求第二意见。顾问以只读子代理身份运行，自动获得当前会话的有界抄本（或以盲审模式独立判断），失败沿链顺延到下一个模型；支持追问与双意见对比。",
  "private": false,
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs/DETAIL.md",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "postbuild": "node -e \"const fs=require('fs');const s='lib/client.iife.js',d='lib/client.js';if(fs.existsSync(s)){fs.renameSync(s,d);console.log('renamed',s,'->',d)}else if(!fs.existsSync(d)){console.error('client bundle missing');process.exit(1)}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "advisor-chain",
    "second-opinion",
    "advisor",
    "subagent",
    "fallback-chain"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "~3.20.0-alpha.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-bash": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-tool-pwsh": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.4 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
